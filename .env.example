# Concert listings from Ticketmaster's Discovery API (free key at developer.ticketmaster.com).
# Without it, find_concerts returns demo listings, marked as such in the data and on the card.
TICKETMASTER_API_KEY=

# Where fan pledge campaigns live (a Fanroute deployment).
FANROUTE_URL=https://fanroute-zeta.vercel.app

# Optional: the simulator's "brain". With a key, Claude answers using the MCP tools;
# without one, a deterministic intent router does.
ANTHROPIC_API_KEY=
# Or a free Groq key (console.groq.com): used when ANTHROPIC_API_KEY is empty.
GROQ_API_KEY=
# ASSISTANT_GROQ_MODEL=openai/gpt-oss-120b
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_BRAIN=rules

# Optional: the public origin the simulator uses to reach /api/mcp (defaults to the request's origin).
# PUBLIC_BASE_URL=https://your-deployment.vercel.app
